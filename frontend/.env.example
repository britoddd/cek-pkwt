# Copy to frontend/.env for a production build (on Vercel, set it under Environment Variables).
# Backend address without /api at the end, e.g. https://cekpkwt-api.britod.my.id
# Read at build time: rebuild or redeploy after changing it.
# Leave empty for local development: the Vite dev server forwards /api to the backend on port 8000.
VITE_API_BASE=
