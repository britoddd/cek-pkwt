# Server-only settings for deploy/docker-compose.yml.
# Copy to deploy/.env and fill in. Never commit .env to GitHub.
# (The FastAPI backend reads the separate .env in the repo root.)

# The flows were exported from Langflow 1.12.4, so the server runs the same version.
# Check the tag exists on Docker Hub (langflowai/langflow). If a flow reports a missing
# component after import, switch to the extended image: LANGFLOW_IMAGE=langflowai/langflow-all
LANGFLOW_IMAGE=langflowai/langflow
LANGFLOW_VERSION=1.12.4

# Database. Letters and digits only in the password: special characters break the URL.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_USER=langflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=langflow

# Langflow admin login
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_strong_password

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LANGFLOW_SECRET_KEY=CHANGE_ME

# Origins allowed to call Langflow from a browser: just the Langflow subdomain.
LANGFLOW_CORS_ORIGINS=https://cekpkwt-langflow.britod.my.id

# Provider keys the flows use (same names as the repo-root .env.example).
ASTRA_DB_PKWT=
COMPOSIO_PKWT=
GOOGLE_API_KEY=
OPENAI_API_KEY=
